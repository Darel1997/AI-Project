# ─── Core ────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://repoinsight:repoinsight@db:5432/repoinsight
DATABASE_URL_SYNC=postgresql://repoinsight:repoinsight@db:5432/repoinsight
POSTGRES_USER=repoinsight
POSTGRES_PASSWORD=repoinsight
POSTGRES_DB=repoinsight

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── GitHub OAuth ────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── AI Chat (pick ONE — Claude is free with Pro) ───
# Option 1: Anthropic Claude (recommended — free with Claude Pro)
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI (requires paid credits)
OPENAI_API_KEY=not-set
OPENAI_MODEL=gpt-4o

# Embeddings are FREE — runs locally, no API key needed
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Encryption key for sensitive tokens at rest ─────
# REQUIRED in production. Generate with: openssl rand -base64 32
# Without it, GitHub OAuth tokens would sit plaintext in the DB. The
# production-safety check refuses to boot without this set.
ENCRYPTION_KEY=

# Old keys, comma-separated, accepted for decryption only.
# Use this to rotate the primary key without breaking existing tokens.
ENCRYPTION_KEY_ROTATION=

# ─── Trusted reverse proxies ─────────────────────────
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Empty = trust no one.
# Examples: "127.0.0.1" (nginx on same host), "10.0.0.0/8" (private VPC).
# Without this, an attacker can rotate XFF values to bypass rate limits.
TRUSTED_PROXIES=
