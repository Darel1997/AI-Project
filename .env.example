# ─── Core ────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://repoinsight:repoinsight@db:5432/repoinsight
DATABASE_URL_SYNC=postgresql://repoinsight:repoinsight@db:5432/repoinsight
POSTGRES_USER=repoinsight
POSTGRES_PASSWORD=repoinsight
POSTGRES_DB=repoinsight

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── GitHub OAuth ────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── AI Chat (pick ONE — Claude is free with Pro) ───
# Option 1: Anthropic Claude (recommended — free with Claude Pro)
# Get your API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI (requires paid credits)
OPENAI_API_KEY=not-set
OPENAI_MODEL=gpt-4o

# Embeddings are FREE — runs locally, no API key needed
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── Frontend ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
