    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.0",
    "@types/react": "18.3.0",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "25.0.1",
